{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DermaCare API Server",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/app/main.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "DermaCare All Tests",
      "type": "python",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-p", "test_*.py"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
